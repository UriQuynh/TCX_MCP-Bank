# ---- Transport ----
# stdio: chạy dưới Claude Code / Claude Desktop, API key lấy từ BANK_MCP_API_KEY
# http : Streamable HTTP, API key lấy từ header Authorization: Bearer <key> hoặc X-API-Key
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3020
# Host header được phép khi bind 0.0.0.0 (chống DNS rebinding), phân cách bằng dấu phẩy
MCP_ALLOWED_HOSTS=
# Phiên HTTP không hoạt động quá N ms sẽ bị đóng
MCP_SESSION_TTL_MS=1800000
# Bắt buộc request /mcp và /webhooks đã qua proxy TLS (X-Forwarded-Proto: https).
# Bỏ trống = tự động: true khi MCP_HTTP_HOST khác loopback, false khi bind 127.0.0.1
MCP_REQUIRE_HTTPS=

# ---- API key (stdio only) ----
BANK_MCP_API_KEY=

# ---- Kho API key + audit ----
API_KEYS_FILE=./data/api-keys.json
AUDIT_LOG_FILE=./data/audit.log
# Giới hạn mặc định (req/phút/key) nếu key không tự khai
RATE_LIMIT_PER_MINUTE=60
# Chạy nhiều instance: rate-limit chia sẻ qua Redis (bỏ trống = bộ nhớ, 1 instance)
REDIS_URL=
# Redis lỗi: true = cho qua, false (mặc định) = chặn
RATE_LIMIT_FAIL_OPEN=false

# ---- Bank provider ----
# mock  : sổ cái trong bộ nhớ (mất khi restart) - dev/test
# local : sổ cái SQLite bền vững tại LEDGER_DB_FILE - TCX tự giữ sổ phụ
# http  : adapter REST tổng quát tới API ngân hàng/VA provider (xem README mục "HTTP provider")
BANK_PROVIDER=mock
LEDGER_DB_FILE=./data/ledger.sqlite
BANK_API_BASE_URL=
BANK_API_KEY=
BANK_API_SECRET=
BANK_API_TIMEOUT_MS=10000
# Chỉ bật khi sandbox ngân hàng dùng http:// (KHÔNG bật ở prod)
BANK_API_ALLOW_INSECURE=false

# ---- Giới hạn nghiệp vụ ----
MAX_TRANSFER_AMOUNT_VND=500000000

# ---- Webhook "báo có" từ ngân hàng (POST /webhooks/bank/incoming) ----
# Bỏ trống = tắt webhook. Header: X-Bank-Timestamp + X-Bank-Signature (HMAC-SHA256)
BANK_WEBHOOK_SECRET=
BANK_WEBHOOK_TOLERANCE_SEC=300
# Chuyển tiếp bản ghi tiền vào sang hệ thống khác (vd TCX_Backend), ký bằng X-TCX-Signature
INCOMING_PAYMENT_FORWARD_URL=
INCOMING_PAYMENT_FORWARD_SECRET=
