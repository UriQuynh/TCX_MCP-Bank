{
  "name": "tcx-mcp-bank",
  "version": "0.1.0",
  "description": "MCP server (Model Context Protocol) để kết nối ngân hàng và tạo ví/tài khoản nhận tiền — mọi tool khoá sau API key có scope",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bank",
    "wallet",
    "fintech",
    "claude",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UriQuynh/TCX_MCP-Bank.git"
  },
  "homepage": "https://github.com/UriQuynh/TCX_MCP-Bank#readme",
  "bugs": {
    "url": "https://github.com/UriQuynh/TCX_MCP-Bank/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "tcx-mcp-bank": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "keys": "tsx scripts/keys.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "ioredis": "^5.11.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
